{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "penny_dialog",
  "rules": {
    "text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "`"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_contents"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                },
                {
                  "type": "STRING",
                  "value": "`"
                }
              ]
            },
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": ">"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_contents"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "PREC",
              "value": -1,
              "content": {
                "type": "SYMBOL",
                "name": "_contents"
              }
            }
          ]
        },
        {
          "type": "BLANK"
        }
      ]
    },
    "_contents": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "pure"
          },
          {
            "type": "SYMBOL",
            "name": "translation_marker"
          },
          {
            "type": "SYMBOL",
            "name": "path"
          },
          {
            "type": "SYMBOL",
            "name": "_tag"
          },
          {
            "type": "SYMBOL",
            "name": "expression"
          },
          {
            "type": "SYMBOL",
            "name": "escape_sequence"
          }
        ]
      }
    },
    "escape_sequence": {
      "type": "PREC",
      "value": 10,
      "content": {
        "type": "PATTERN",
        "value": "\\\\\\S"
      }
    },
    "number": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "\\d+"
        },
        {
          "type": "PATTERN",
          "value": "\\d+\\.\\d+"
        },
        {
          "type": "PATTERN",
          "value": "[\\.]\\d+"
        },
        {
          "type": "PATTERN",
          "value": "\\d+([:\\.]\\d+)+"
        }
      ]
    },
    "pure": {
      "type": "PREC",
      "value": -1,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_formal"
          },
          {
            "type": "SYMBOL",
            "name": "informal"
          }
        ]
      }
    },
    "_formal": {
      "type": "TOKEN",
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "PATTERN",
          "value": "[^\\\\\\d\\/@#$%^&*+=_`|<>{}\\[\\]]"
        }
      }
    },
    "informal": {
      "type": "PREC",
      "value": -10,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "SYMBOL",
            "name": "_informal_misc"
          }
        ]
      }
    },
    "_informal_misc": {
      "type": "PATTERN",
      "value": "[\\/@#$%^&*+=_`|\\\\<>{}\\[\\]]"
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "expression_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "path": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "\\.?(?:~|[a-z_][a-z_0-9]*)(\\.(?:~|[a-z_][a-z_0-9]*))*",
            "flags": "i"
          },
          "named": true,
          "value": "path_content"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-z_][a-z_0-9]*",
      "flags": "i"
    },
    "translation_marker": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "lang"
            },
            {
              "type": "SYMBOL",
              "name": "lang_invalid"
            }
          ]
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "lang": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "PATTERN",
        "value": "[a-z\\-]+",
        "flags": "i"
      }
    },
    "lang_invalid": {
      "type": "PATTERN",
      "value": "[^\\]]+"
    },
    "_tag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "tag_start"
        },
        {
          "type": "SYMBOL",
          "name": "tag_end"
        },
        {
          "type": "SYMBOL",
          "name": "tag_clear"
        }
      ]
    },
    "tag_start": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "decor"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": "|"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "decor"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "tag_end": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "identifier"
                },
                {
                  "type": "REPEAT",
                  "content": {
                    "type": "SEQ",
                    "members": [
                      {
                        "type": "STRING",
                        "value": "|"
                      },
                      {
                        "type": "SYMBOL",
                        "name": "identifier"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "tag_clear": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "</"
        },
        {
          "type": "STRING",
          "value": "*"
        },
        {
          "type": "STRING",
          "value": ">"
        }
      ]
    },
    "decor": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "arg"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "arg"
              }
            ]
          }
        }
      ]
    },
    "arg": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "identifier"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "="
                  },
                  {
                    "type": "SYMBOL",
                    "name": "arg_value"
                  }
                ]
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "arg_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^@{}'\"`|>\\s]+"
        },
        {
          "type": "SYMBOL",
          "name": "_quoted_string"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        }
      ]
    },
    "_quoted_string": {
      "type": "PREC",
      "value": 100,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "'"
              },
              {
                "type": "PATTERN",
                "value": "[^']*"
              },
              {
                "type": "STRING",
                "value": "'"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "PATTERN",
                "value": "[^\"]*"
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "`"
              },
              {
                "type": "PATTERN",
                "value": "[^`]*"
              },
              {
                "type": "STRING",
                "value": "`"
              }
            ]
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "expression_content"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}